{
	"$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
        "userId": { "type": "integer" },
        "userFirstName": { "type": "string" },
        "userLastName": { "type": "string" },
        "userContactNumber": { "type": "integer" },
        "userEmailId": { "type": "string",
                        "format": "email" }, 
        "creationTime": { "type": "string" },
        "lastModTime": { "type": "string" },
        "userAddress": {
            "type": "object",
            "properties": {
                "addressId": { "type": "integer" },
                "plotNumber": { "type": "string" },
                "street": { "type": "string" },
                "state": { "type": "string" },
                "country": { "type": "string" },
                "zipCode": { "type": "integer" }
            },
            "required": ["addressId"]
        }
    },
    "required": ["userId", "userFirstName",  "userLastName", "userContactNumber", "userEmailId", "creationTime","lastModTime"]
}